# --- Database (Supabase Postgres) ---
# Pooled connection (via Supabase's connection pooler / pgbouncer) - used by the app at runtime.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection - used by Prisma Migrate to run migrations.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- Auth (NextAuth / Auth.js) ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Twilio ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Public, HTTPS-reachable base URL for this app (Twilio webhooks). Use an ngrok
# tunnel in local dev, your real domain in production.
APP_URL=""
